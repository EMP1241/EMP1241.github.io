# Keep binary assets byte-for-byte intact on Windows and GitHub Pages.
*.pdf binary
*.png binary
*.webp binary
*.mp4 binary
*.zip binary
# Hash examples compare original bytes; keep text endings stable after checkout.
assets/examples/handoff-integrity/** text eol=lf
# Preserve the exact owner-supplied paper source against its delivery hash.
docs/research-architect-white-paper.md -text
